# ========== PLATFORM ==========
API_KEY=platform-fallback-not-used
DATABASE_URL=sqlite:///./payhub.db
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Master key to encrypt users' Binance secrets (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=replace-with-fernet-key

# JWT
JWT_SECRET=replace-with-long-random-jwt-secret-min-32-chars
JWT_EXPIRE_HOURS=72

# First admin (created on startup if no admin exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-strong-password

# Defaults for new users
DEFAULT_DEPOSIT_COIN=USDT
DEFAULT_DEPOSIT_NETWORK=TRX
MATCH_LOOKBACK_MINUTES=120
INVOICE_EXPIRE_MINUTES=60
